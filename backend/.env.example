# ── Server ───────────────────────────────────────────────────────────────
# Port the API listens on. Render sets this automatically; local dev uses 5000.
PORT=5000

# ── Database (required) ──────────────────────────────────────────────────
# Your MongoDB connection string. Use MongoDB Atlas (https://www.mongodb.com/atlas):
#   1. Create a free cluster
#   2. Add your IP to Network Access
#   3. Create a database user
#   4. Copy the connection string from "Connect your application"
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/friendship_test?retryWrites=true&w=majority

# ── Auth ────────────────────────────────────────────────────────────────
# Secret used to sign login tokens (HMAC-SHA256). Generate one, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In dev it falls back to a default; always set this in production!
JWT_SECRET=change-me-to-a-long-random-string

# ── CORS ─────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# Local dev:        http://localhost:5173
# Vercel frontend:  https://your-frontend.vercel.app
CLIENT_URL=http://localhost:5173

# ── Optional: Cloudinary (image questions) ───────────────────────────────
# Only needed if you add image-upload support for questions.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret
